									"pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
									"",
									"const todo = pm.response.json();",
									"pm.test(\"Todo has expected fields\", () => {",
									"  pm.expect(todo.title).to.eql(\"Buy milk\");",
									"  pm.expect(todo.priority).to.eql(\"high\");",
									"  pm.expect(todo.completed).to.eql(false);",
									"});",
									"",
									"pm.collectionVariables.set(\"todoId\", todo.id);"
